<% content_for :page_title do %>
  Event Details - <%= @event.exception_class %>
<% end %>

<!-- Breadcrumb -->
<nav class="flex items-center justify-between mb-6" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-3">
    <li class="inline-flex items-center">
      <%= link_to project_path(@project), class: "inline-flex items-center text-sm font-medium text-gray-700 hover:text-indigo-600" do %>
        <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0L2.586 11a2 2 0 010-2.828l3.707-3.707a1 1 0 011.414 1.414L4.414 9H17a1 1 0 110 2H4.414l3.293 3.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
        </svg>
        <%= @project.name %>
      <% end %>
    </li>
    <li>
      <div class="flex items-center">
        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <%= link_to "Events", project_events_path(@project), class: "ml-1 text-sm font-medium text-gray-500 md:ml-2 hover:text-gray-700" %>
      </div>
    </li>
    <li>
      <div class="flex items-center">
        <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
        </svg>
        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Event #<%= @event.id %></span>
      </div>
    </li>
  </ol>

  <div class="flex items-center space-x-2">
    <%= link_to project_event_path(@project, @event), method: :delete, data: { confirm: "Are you sure you want to delete this event?" }, class: "inline-flex items-center px-3 py-2 text-sm font-medium text-red-600 hover:text-red-700 hover:bg-red-50 rounded-md" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
      </svg>
      Delete Event
    <% end %>
  </div>
</nav>

<!-- Event Header -->
<div class="bg-white rounded-lg shadow mb-6">
  <div class="px-6 py-4 border-b border-gray-200">
    <div class="flex items-start justify-between">
      <div class="flex-1">
        <h1 class="text-xl font-semibold text-gray-900 mb-2">
          <%= @event.exception_class %>
        </h1>
        <% if @event.message.present? %>
          <p class="text-gray-600 mb-4"><%= @event.message %></p>
        <% end %>
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
          <div>
            <span class="font-medium">Occurred:</span>
            <span class="ml-1"><%= time_ago_in_words(@event.occurred_at) %> ago</span>
            <span class="ml-1">(<%= @event.occurred_at.strftime("%b %d, %Y %H:%M:%S") %>)</span>
          </div>
          <div>
            <span class="font-medium">Environment:</span>
            <span class="ml-1 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
              <%= @event.environment %>
            </span>
          </div>
          <% if @event.controller_action.present? %>
            <div>
              <span class="font-medium">Controller/Action:</span>
              <span class="ml-1"><%= @event.controller_action %></span>
            </div>
          <% end %>
          <% if @event.request_path.present? %>
            <div>
              <span class="font-medium">Path:</span>
              <span class="ml-1 font-mono text-xs"><%= @event.request_path %></span>
            </div>
          <% end %>
          <% if @event.request_method.present? %>
            <div>
              <span class="font-medium">Method:</span>
              <span class="ml-1"><%= @event.request_method %></span>
            </div>
          <% end %>
          <% if @event.issue %>
            <div>
              <span class="font-medium">Issue:</span>
              <%= link_to "Issue ##{@event.issue.id}", project_issue_path(@project, @event.issue), class: "ml-1 text-indigo-600 hover:text-indigo-900" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Backtrace -->
<% if @event.backtrace.present? %>
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Stack Trace</h2>
    </div>
    <div class="px-6 py-4">
      <div class="bg-gray-50 rounded-lg p-4 overflow-x-auto">
        <pre class="text-sm text-gray-800 whitespace-pre-wrap font-mono"><code><%= @event.formatted_backtrace.join("\n") %></code></pre>
      </div>
    </div>
  </div>
<% end %>

<!-- Payload -->
<div class="bg-white rounded-lg shadow mb-6">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-lg font-medium text-gray-900">Event Payload</h2>
  </div>
  <div class="px-6 py-4">
    <div class="bg-gray-50 rounded-lg p-4 overflow-x-auto">
      <pre class="text-sm text-gray-800 whitespace-pre-wrap font-mono"><code><%= @formatted_payload %></code></pre>
    </div>
  </div>
</div>

<!-- Context -->
<% if @event.context.present? && @event.context.is_a?(Hash) && @event.context.any? %>
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Context</h2>
    </div>
    <div class="px-6 py-4">
      <dl class="divide-y divide-gray-200">
        <% @event.context.each do |key, value| %>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500"><%= key.to_s.humanize %>:</dt>
            <dd class="text-sm text-gray-900 col-span-2">
              <% if value.is_a?(Hash) || value.is_a?(Array) %>
                <pre class="text-xs bg-gray-50 p-2 rounded overflow-x-auto"><code><%= JSON.pretty_generate(value) %></code></pre>
              <% else %>
                <%= value.to_s %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
<% end %>

<!-- Additional Metadata -->
<div class="bg-white rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200">
    <h2 class="text-lg font-medium text-gray-900">Additional Metadata</h2>
  </div>
  <div class="px-6 py-4">
    <dl class="divide-y divide-gray-200">
      <% if @event.release_version.present? %>
        <div class="py-3 grid grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-gray-500">Release Version:</dt>
          <dd class="text-sm text-gray-900 col-span-2"><%= @event.release_version %></dd>
        </div>
      <% end %>
      <% if @event.server_name.present? %>
        <div class="py-3 grid grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-gray-500">Server Name:</dt>
          <dd class="text-sm text-gray-900 col-span-2"><%= @event.server_name %></dd>
        </div>
      <% end %>
      <% if @event.request_id.present? %>
        <div class="py-3 grid grid-cols-3 gap-4">
          <dt class="text-sm font-medium text-gray-500">Request ID:</dt>
          <dd class="text-sm text-gray-900 col-span-2 font-mono text-xs"><%= @event.request_id %></dd>
        </div>
      <% end %>
      <div class="py-3 grid grid-cols-3 gap-4">
        <dt class="text-sm font-medium text-gray-500">Created At:</dt>
        <dd class="text-sm text-gray-900 col-span-2"><%= @event.created_at.strftime("%b %d, %Y %H:%M:%S") %></dd>
      </div>
    </dl>
  </div>
</div>

