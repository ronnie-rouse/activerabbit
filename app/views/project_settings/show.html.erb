<% content_for :page_title do %>
  <%= @project.name %> - Settings
<% end %>

<div class="max-w-4xl mx-auto">
  <!-- Header -->
  <div class="mb-8">
    <nav class="flex items-center space-x-2 text-sm text-gray-500 mb-4">
      <%= link_to "Dashboard", dashboard_path, class: "hover:text-gray-700" %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
      </svg>
      <%= link_to @project.name, project_path(@project), class: "hover:text-gray-700" %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-gray-900">Settings</span>
    </nav>

    <h1 class="text-2xl font-bold text-gray-900">Project Settings</h1>
    <p class="text-gray-600 mt-1">Configure notifications and integrations for <%= @project.name %></p>
  </div>

  <!-- API Token Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center">
        <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m0 0a2 2 0 012 2m-2-2h-6m6 0v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9a2 2 0 012-2h6m-6 0a2 2 0 012-2m0 0h6a2 2 0 012 2M9 7h6"></path>
        </svg>
        <div>
          <h3 class="text-lg font-medium text-gray-900">API Token</h3>
          <p class="text-sm text-gray-500">Use this token to authenticate your application with ActiveRabbit</p>
        </div>
      </div>
    </div>
    <div class="p-6">
      <% if @api_tokens.any? %>
        <% token = @api_tokens.first %>
        <div class="p-4 bg-gray-50 rounded-lg">
          <div class="flex items-center justify-between mb-3">
            <p class="text-sm font-medium text-gray-900"><%= token.name %></p>
            <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">
              Active
            </span>
          </div>
          <div class="bg-white p-3 rounded border flex items-center justify-between">
            <p class="text-sm text-gray-700 font-mono break-all select-all flex-1 mr-3"><%= token.token %></p>
            <button onclick="copyToClipboard('<%= token.token %>')" class="flex-shrink-0 p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded transition-colors" title="Copy to clipboard">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="mt-4">
          <div class="flex items-center justify-between">
            <p class="text-sm text-gray-500">
              Use this token in your application's ActiveRabbit configuration
            </p>
            <div class="flex items-center space-x-3">
              <button type="button"
                      onclick="toggleFullConfig()"
                      class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 4h13M8 9h13M3 14h18M3 19h18"></path>
                </svg>
                Full config
              </button>
              <%= button_to "Regenerate Token",
                  regenerate_token_project_path(@project),
                  method: :post,
                  data: { confirm: "Are you sure you want to regenerate the API token?\n\nThis will:\n• Invalidate the current token immediately\n• Require updating all applications using this token\n• Cannot be undone\n\nContinue?" },
                  class: "inline-flex items-center px-3 py-2 border border-red-300 text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
            </div>
          </div>

          <!-- Inline full config panel -->
          <div id="full-config-panel" class="mt-4 hidden">
            <div class="bg-gray-900 rounded-lg p-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-gray-400 text-xs sm:text-sm">config/initializers/activerabbit.rb</span>
                <button id="copy-full-config-btn"
                        type="button"
                        onclick="copyInitializerConfig()"
                        class="text-gray-400 hover:text-white text-xs sm:text-sm">
                  📋 Copy
                </button>
              </div>
              <pre id="full-config-code" class="text-green-400 text-xs sm:text-sm overflow-x-auto select-text whitespace-pre"><code><%= render "shared/full_client_config_code", project: @project %></code></pre>
            </div>
          </div>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <svg class="w-12 h-12 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m0 0a2 2 0 012 2m-2-2h-6m6 0v6a2 2 0 01-2 2H9a2 2 0 01-2-2V9a2 2 0 012-2h6m-6 0a2 2 0 012-2m0 0h6a2 2 0 012 2M9 7h6"></path>
          </svg>
          <p>No active API token found.</p>
          <p class="text-sm mt-1">Click "Generate Token" to create one.</p>
                    <%= button_to "Generate Token",
                regenerate_token_project_path(@project),
                method: :post,
                data: { confirm: "Are you sure you want to generate a new API token?\n\nThis will create a new token for your project.\n\nContinue?" },
                class: "mt-4 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Slack Integration Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <div class="flex items-center">
          <svg class="w-6 h-6 text-purple-600 mr-3" fill="currentColor" viewBox="0 0 24 24">
            <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52-2.523c0-1.393 1.135-2.524 2.52-2.524h2.52v2.524c0 1.393-1.127 2.523-2.52 2.523zm0 0c-1.393 0-2.52 1.135-2.52 2.523v2.52c0 1.393 1.127 2.524 2.52 2.524 1.393 0 2.523-1.131 2.523-2.524v-2.52c0-1.388-1.13-2.523-2.523-2.523zm7.12-7.12a2.528 2.528 0 0 1-2.523-2.52c0-1.393 1.135-2.524 2.523-2.524 1.393 0 2.524 1.131 2.524 2.524v2.52c0 1.393-1.131 2.52-2.524 2.52zm0 0c1.393 0 2.524 1.127 2.524 2.52v2.523c0 1.393-1.131 2.524-2.524 2.524-1.388 0-2.523-1.131-2.523-2.524V15.685c0-1.393 1.135-2.52 2.523-2.52z"/>
          </svg>
          <div>
            <h3 class="text-lg font-medium text-gray-900">Slack Integration</h3>
            <p class="text-sm text-gray-500">Get real-time notifications in your Slack workspace</p>
          </div>
        </div>
        <div class="flex items-center">
          <% if @project.slack_configured? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Configured
            </span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
              <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
              </svg>
              Not Configured
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="p-6">
      <%= form_with(model: @project, url: project_settings_path(@project), method: :patch, local: true, class: "space-y-6") do |form| %>

                <!-- Webhook URL -->
        <div>
          <label for="slack_webhook_url" class="block text-sm font-medium text-gray-700 mb-2">
            Slack Webhook URL
            <span class="text-red-500">*</span>
          </label>

          <% if @project.slack_webhook_from_env? %>
            <div class="mb-3 p-3 bg-green-50 border border-green-200 rounded-md">
              <div class="flex items-center">
                <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-green-800 font-medium">Webhook URL configured via environment variable</span>
              </div>
              <p class="text-xs text-green-700 mt-1">
                Using secure environment variable for webhook URL. This is the recommended approach for production.
              </p>
            </div>
          <% end %>

          <%= form.url_field :slack_webhook_url,
                value: @project.slack_webhook_from_env? ? '' : @project.slack_webhook_url,
                placeholder: @project.slack_webhook_from_env? ? "Configured via environment variable" : "https://hooks.slack.com/services/...",
                disabled: @project.slack_webhook_from_env?,
                class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm #{'bg-gray-50 text-gray-500' if @project.slack_webhook_from_env?}" %>

          <div class="mt-2 space-y-1">
            <p class="text-xs text-gray-500">
              Get your webhook URL from
              <a href="https://api.slack.com/apps" target="_blank" class="text-blue-600 hover:text-blue-500">
                Slack Apps → Incoming Webhooks
              </a>
            </p>
            <details class="text-xs text-gray-500">
              <summary class="cursor-pointer text-blue-600 hover:text-blue-500">🔒 Security Options</summary>
              <div class="mt-2 p-2 bg-gray-50 rounded border-l-2 border-blue-200">
                <p class="mb-2"><strong>For production environments:</strong></p>
                <p class="mb-1">• Set <code>SLACK_WEBHOOK_URL</code> environment variable (all projects)</p>
                <p class="mb-1">• Set <code>SLACK_WEBHOOK_URL_<%= @project.slug.upcase %></code> for this project only</p>
                <p class="text-gray-400">Environment variables are more secure than database storage</p>
              </div>
            </details>
          </div>
        </div>

        <!-- Channel -->
        <div>
          <label for="slack_channel" class="block text-sm font-medium text-gray-700 mb-2">
            Slack Channel
          </label>
          <%= form.text_field :slack_channel,
                value: @project.slack_channel,
                placeholder: "#alerts",
                class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
          <p class="mt-1 text-xs text-gray-500">
            Channel or user to send notifications to (e.g., #alerts or @username)
          </p>
        </div>

        <!-- Enable/Disable Toggle -->
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <%= form.check_box :slack_notifications_enabled,
                  checked: @project.slack_notifications_enabled?,
                  class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <label for="project_slack_notifications_enabled" class="ml-2 block text-sm text-gray-900">
              Enable Slack notifications
            </label>
          </div>
          <p class="text-xs text-gray-500">
            Turn notifications on/off without removing configuration
          </p>
        </div>


        <!-- Action Buttons -->
        <div class="flex items-center justify-between pt-4 border-t border-gray-200">
          <div class="flex space-x-3">
            <%= form.submit "Save Settings",
                  class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>

            <% if @project.slack_configured? %>
              <%= button_to "Test Notification",
                    test_notification_project_settings_path(@project),
                    method: :post,
                    class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            <% end %>
          </div>

          <% if @project.slack_configured? %>
            <%= form.submit "Save & Test",
                  name: "test_slack",
                  value: "true",
                  class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Git Integration Card -->
  <div class="bg-white rounded-lg shadow-sm border border-gray-200 mb-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center">
        <svg class="w-6 h-6 text-gray-800 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
        <div>
          <h3 class="text-lg font-medium text-gray-900">Git Integration</h3>
          <p class="text-sm text-gray-500">Configure repository and authentication for PR/MR automation</p>
        </div>
      </div>
    </div>
    <div class="p-6">
      <%= form_with(model: @project, url: project_settings_path(@project), method: :patch, local: true, html: { multipart: true }, class: "space-y-4") do |form| %>
        <% git_provider = @project.settings['git_provider'] || 'github' %>
        
        <!-- Provider Selection -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Git Provider</label>
          <div class="flex space-x-4">
            <label class="flex items-center">
              <%= form.radio_button :git_provider, 'github', checked: git_provider == 'github', class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" %>
              <span class="ml-2 text-sm text-gray-700 flex items-center">
                <svg viewBox="0 0 16 16" class="w-4 h-4 mr-1" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.5 7.5 0 012 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
                GitHub
              </span>
            </label>
            <label class="flex items-center">
              <%= form.radio_button :git_provider, 'gitlab', checked: git_provider == 'gitlab', class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" %>
              <span class="ml-2 text-sm text-gray-700 flex items-center">
                <img src="https://about.gitlab.com/images/press/gitlab-logo-600-rgb.png" alt="GitLab" class="w-4 h-4 mr-1 object-contain" />
                GitLab
              </span>
            </label>
          </div>
        </div>

        <!-- GitHub Settings -->
        <div id="github-settings" class="<%= 'hidden' unless git_provider == 'github' %>">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Repository (owner/repo)</label>
              <%= form.text_field :github_repo, value: @project.settings['github_repo'], placeholder: "owner/repo", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Installation ID</label>
              <%= form.text_field :github_installation_id, value: @project.settings['github_installation_id'], placeholder: "12345678", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Personal Access Token (optional)</label>
              <%= form.password_field :github_pat, value: @project.settings['github_pat'], placeholder: "ghp_...", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
              <p class="text-xs text-gray-500 mt-1">Used if provided. Otherwise the App credentials are used.</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">GitHub App ID (optional)</label>
              <%= form.text_field :github_app_id, value: @project.settings['github_app_id'], placeholder: "12345", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>
          </div>
          <div class="mt-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Upload GitHub App Private Key (PEM file)</label>
            <%= form.file_field :github_app_pk_file, accept: ".pem", class: "block w-full text-sm text-gray-700" %>
            <p class="text-xs text-gray-500 mt-1">If provided, this overrides any pasted PEM value.</p>
          </div>
          <div class="mt-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Or paste GitHub App Private Key (PEM)</label>
            <%= form.text_area :github_app_pk, value: @project.settings['github_app_pk'], placeholder: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----", rows: 6, class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm font-mono" %>
            <p class="text-xs text-gray-500 mt-1">Stored per project. Prefer secrets manager in production.</p>
          </div>
          <p class="text-xs text-gray-500 mt-4">
            Permissions needed: <strong>Pull requests</strong> (read/write) and <strong>Contents</strong> (read). Docs: <a href="https://docs.github.com/en/apps/creating-github-apps/authenticating-with-a-github-app/generating-an-installation-access-token-for-a-github-app" target="_blank" class="text-blue-600 hover:text-blue-500">GitHub App installation tokens</a> · <a href="https://docs.github.com/rest/pulls/pulls" target="_blank" class="text-blue-600 hover:text-blue-500">Pull Requests API</a>.
          </p>
        </div>

        <!-- GitLab Settings -->
        <div id="gitlab-settings" class="<%= 'hidden' unless git_provider == 'gitlab' %>">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Repository Path</label>
              <%= form.text_field :gitlab_repo, value: @project.settings['gitlab_repo'], placeholder: "group/project", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
              <p class="text-xs text-gray-500 mt-1">Project path only (e.g., <code>oss/oss</code> or <code>gitlab-org/gitlab</code>). Do NOT include the full URL.</p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">GitLab Host</label>
              <%= form.text_field :gitlab_host, value: @project.settings['gitlab_host'] || 'https://gitlab.com', placeholder: "https://gitlab.com", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
              <p class="text-xs text-gray-500 mt-1">Leave as default for GitLab.com, or use your self-hosted instance URL</p>
            </div>
          </div>
          <div class="mt-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Personal Access Token</label>
            <%= form.password_field :gitlab_token, value: @project.settings['gitlab_token'], placeholder: "glpat-...", class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            <p class="text-xs text-gray-500 mt-1">Create a token with <strong>api</strong> scope. Docs: <a href="https://docs.gitlab.com/api/rest/" target="_blank" class="text-blue-600 hover:text-blue-500">GitLab REST API</a></p>
          </div>
          <p class="text-xs text-gray-500 mt-4">
            Permissions needed: <strong>api</strong> scope for creating merge requests and managing branches. Docs: <a href="https://docs.gitlab.com/api/rest/" target="_blank" class="text-blue-600 hover:text-blue-500">GitLab REST API</a> · <a href="https://docs.gitlab.com/ee/api/merge_requests.html" target="_blank" class="text-blue-600 hover:text-blue-500">Merge Requests API</a>.
          </p>
        </div>

        <div class="pt-2">
          <%= form.submit "Save Git Settings",
                class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    // Toggle between GitHub and GitLab settings
    document.addEventListener('DOMContentLoaded', function() {
      const githubRadio = document.querySelector('input[value="github"][name="project[git_provider]"]');
      const gitlabRadio = document.querySelector('input[value="gitlab"][name="project[git_provider]"]');
      const githubSettings = document.getElementById('github-settings');
      const gitlabSettings = document.getElementById('gitlab-settings');

      function toggleSettings() {
        if (githubRadio && githubRadio.checked) {
          githubSettings.classList.remove('hidden');
          gitlabSettings.classList.add('hidden');
        } else if (gitlabRadio && gitlabRadio.checked) {
          githubSettings.classList.add('hidden');
          gitlabSettings.classList.remove('hidden');
        }
      }

      if (githubRadio) githubRadio.addEventListener('change', toggleSettings);
      if (gitlabRadio) gitlabRadio.addEventListener('change', toggleSettings);
    });
  </script>

