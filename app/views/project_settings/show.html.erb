                  <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-sm text-green-800 font-medium">Endpoint URL configured via environment variable</span>
              </div>
              <p class="text-xs text-green-700 mt-1">
                Using secure environment variable for endpoint URL. This is the recommended approach for production.
              </p>
